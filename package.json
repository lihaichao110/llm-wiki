{
  "name": "@lihaichao/llm-wiki",
  "version": "1.0.2",
  "description": "将网页和 PDF 整理为可由大语言模型编译的结构化 Wiki",
  "bin": {
    "llm-wiki": "dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean",
    "dev": "tsup src/index.ts --format esm --watch",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "release": "git push origin main --follow-tags",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "llm",
    "wiki",
    "markdown",
    "pdf",
    "cli"
  ],
  "author": "lihaichao",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lihaichao110/llm-wiki.git"
  },
  "homepage": "https://github.com/lihaichao110/llm-wiki#readme",
  "bugs": {
    "url": "https://github.com/lihaichao110/llm-wiki/issues"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/turndown": "^5.0.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "jsdom": "^30.1.1",
    "listr2": "^11.1.1",
    "ora": "^9.4.1",
    "pdf-parse": "^2.4.5",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "yaml": "^2.9.1"
  }
}
