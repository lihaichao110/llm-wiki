{
  "name": "@lihaichao/llm-wiki",
  "version": "1.0.13",
  "packageManager": "pnpm@11.1.2",
  "description": "将在线文件与本地文件整理为可由大语言模型编译的结构化 Wiki",
  "bin": {
    "llm-wiki": "dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean && esbuild src/view/client.ts src/view/index.html --bundle --platform=browser --format=iife --outdir=dist --loader:.html=copy",
    "dev": "concurrently -k -n cli,view \"tsup src/index.ts --format esm --watch\" \"esbuild src/view/client.ts src/view/index.html --bundle --platform=browser --format=iife --outdir=dist --loader:.html=copy --watch\"",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm test",
    "prepare": "husky",
    "release": "git push origin main --follow-tags",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run check",
    "push": "pnpm version patch && pnpm run release"
  },
  "keywords": [
    "llm",
    "wiki",
    "markdown",
    "pdf",
    "cli"
  ],
  "author": "lihaichao",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lihaichao110/llm-wiki.git"
  },
  "homepage": "https://github.com/lihaichao110/llm-wiki#readme",
  "bugs": {
    "url": "https://github.com/lihaichao110/llm-wiki/issues"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/turndown": "^5.0.6",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@openrouter/sdk": "1.4.24",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "cytoscape": "^3.34.4",
    "jsdom": "^30.1.1",
    "listr2": "^11.1.1",
    "open": "^11.0.4",
    "ora": "^9.4.1",
    "pdf-parse": "^2.4.5",
    "tesseract.js": "^6.0.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yaml": "^2.9.1"
  }
}
